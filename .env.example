# Telegram @BotFather bergan token (hech kimga yubormang)
BOT_TOKEN=replace-with-new-telegram-bot-token

# Alertlar doim yuboriladigan ikkita shaxsiy chat, guruh yoki kanal ID raqami
# Guruh/kanal ID odatda manfiy bo‘ladi, masalan: -1001234567890
CHAT_ID_1=-1001234567890
CHAT_ID_2=-1009876543210

# Kompaniya API kalitlari
sevensky_api=replace-with-sevensky-api-key
msv_api=replace-with-msv-api-key

# Internetdan keladigan webhooklarni himoyalash uchun alohida maxfiy kalit
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

SUBSCRIBERS_FILE=subscribers.json
PORT=8000

# Bir xil eventId shu vaqt ichida takror kelsa, qayta yuborilmaydi
DEDUPE_SECONDS=300

# Maksimal webhook JSON hajmi (bayt)
MAX_CONTENT_LENGTH=65536

# Telegram/httpx tarmoq sozlamalari
TELEGRAM_CONNECT_TIMEOUT=30.0
TELEGRAM_READ_TIMEOUT=30.0
# -1: boshlang‘ich ulanish muvaffaqiyatli bo‘lguncha qayta urinish
TELEGRAM_BOOTSTRAP_RETRIES=-1
